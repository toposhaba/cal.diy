<?xml version="1.0" encoding="UTF-8"?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>OAuth 2.0 credential for Google Calendar API integration</description>
    <externalCredentialParameters>
        <parameterName>AuthorizationEndpoint</parameterName>
        <parameterType>AuthorizationEndpoint</parameterType>
        <parameterValue>https://accounts.google.com/o/oauth2/v2/auth</parameterValue>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterName>TokenEndpoint</parameterName>
        <parameterType>TokenEndpoint</parameterType>
        <parameterValue>https://oauth2.googleapis.com/token</parameterValue>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterName>Scope</parameterName>
        <parameterType>Scope</parameterType>
        <parameterValue>https://www.googleapis.com/auth/calendar.readonly https://www.googleapis.com/auth/calendar.events</parameterValue>
    </externalCredentialParameters>
    <label>Google Calendar Credential</label>
    <principalType>NamedPrincipal</principalType>
    <protocol>OAuth</protocol>
</ExternalCredential>
