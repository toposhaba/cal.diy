<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>End_After_Start</fullName>
    <active>true</active>
    <description>End time must be after start time</description>
    <errorConditionFormula>End_DateTime__c &lt;= Start_DateTime__c</errorConditionFormula>
    <errorDisplayField>End_DateTime__c</errorDisplayField>
    <errorMessage>End time must be after start time</errorMessage>
</ValidationRule>
