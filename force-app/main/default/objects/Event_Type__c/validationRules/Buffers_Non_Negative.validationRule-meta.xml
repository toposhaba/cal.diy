<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Buffers_Non_Negative</fullName>
    <active>true</active>
    <description>Buffer times cannot be negative</description>
    <errorConditionFormula>OR(
    Buffer_Before_Minutes__c &lt; 0,
    Buffer_After_Minutes__c &lt; 0
)</errorConditionFormula>
    <errorMessage>Buffer times cannot be negative</errorMessage>
</ValidationRule>
